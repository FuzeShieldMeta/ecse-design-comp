# BOP Rhythm external chart format, version 1
version=BOP1
title=EXAMPLE SONG
artist=YOUR NAME
bpm=120
difficulty=1
color=#8A32FF
audio=/songs/example.wav
cover=/songs/example.rgb888
audio_start=0
audio_loop=0
duration=12000

# note=hit_ms,lane,action,hold_ms,end_action,transition_ms,bonus,
#      start_column,end_column,shift_start_ms,shift_end_ms
note=2000,twist,left,0,same,0,0
note=2500,push,tap,0,same,0,0
note=3000,pull,half,0,same,0,0
note=3500,pull,full,0,same,0,0
note=4500,twist,right,1000,same,0,0
note=6000,pull,half,1600,full,800,0
note=8000,pull,full,1600,half,800,1

# A wind visual and an explicitly timed move from column 0 to column 1.
wind=9000,1800
note=10500,twist,left,0,same,0,0,0,1,9000,10000
